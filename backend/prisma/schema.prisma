// IN NETWORK — Schéma de données (MVP V1)
// Adapté du CDC Technique §4 pour MySQL (XAMPP en local, VPS en production)
// Différences vs. CDC original (pensé pour PostgreSQL) :
//  - String[] non supporté par Prisma sur MySQL -> remplacé par Json
//  - Account/Session/VerificationToken (NextAuth) remplacés par RefreshToken (auth JWT maison)
//  - Champs de vérification email / reset password ajoutés directement sur User

// Migration Prisma 7 (§0 brief) : générateur renommé "prisma-client" avec un
// output explicite hors node_modules ; le driver adapter (@prisma/adapter-mariadb,
// cf. lib/prisma.ts) porte désormais la connexion réelle — l'URL de
// migration/introspection CLI vit dans prisma.config.ts, plus ici.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  // Compte staff à droits restreints (demande client 07/09/2026) : accès au
  // backoffice borné par User.permissions (lecture/écriture par bloc). Créé
  // depuis /admin/compte (« Utilisateurs système ») par un SUPER_ADMIN.
  OFFICE_MANAGER
  MEMBER
}

enum MemberType {
  FREELANCE
  STARTUP
  ENTREPRISE
}

enum SpaceType {
  DESK
  PRIVATE_OFFICE
  MEETING_ROOM
}

enum PlanBillingCycle {
  DAY_PASS
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentRelatedType {
  SUBSCRIPTION
  BOOKING
  SERVICE_REQUEST
}

enum ServiceCategory {
  DOMICILIATION
  CREATION_ENTREPRISE
  ADMINISTRATION
  COMPTABILITE
  JURIDIQUE
  MARKETING
  SECRETARIAT
  AUTRE
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TagCategory {
  SKILL
  SECTOR
}

enum TagRelationType {
  OFFER
  NEED
}

enum SuggestionStatus {
  NEW
  VIEWED
  CONTACTED
  DISMISSED
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EventType {
  CONFERENCE
  ATELIER
  NETWORKING
  MASTERCLASS
}

// Catégorie d'organisation de l'événement (distincte du type CONFERENCE/ATELIER/...)
enum EventOrigin {
  IN_EVENT // organisé en interne par IN NETWORK
  EXTERNAL // événement externe relayé sur la plateforme
  CO_ORGANIZED // co-organisé avec un partenaire
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EventRegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum GalleryOwnerType {
  EVENT
  SITE
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

// Nature d'une ligne du panier de devis (service du catalogue, salle de
// réunion ou formule d'abonnement) — un seul modèle de demande, un seul
// dashboard admin, quelle que soit la nature du catalogue visé.
enum InquiryTargetType {
  SERVICE
  SPACE
  PLAN
}

// ============================================
// IDENTITÉ
// ============================================

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  emailVerified        DateTime?
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  passwordHash         String
  phone                String?
  role                 Role      @default(MEMBER)
  // Permissions backoffice granulaires pour les rôles staff restreints
  // (OFFICE_MANAGER) : { "<bloc>": "read" | "write" }. Ignoré pour
  // SUPER_ADMIN / ADMIN (accès total) et MEMBER (pas de backoffice).
  permissions          Json?
  // Nom affiché pour les comptes staff (qui n'ont pas de MemberProfile).
  displayName          String?
  isActive             Boolean   @default(true)
  // Rattachement à un compte entreprise (demande client 07/09/2026) : un
  // collaborateur invité depuis le dashboard d'une entreprise porte le
  // companyId de celle-ci. Le représentant qui a inscrit l'entreprise est
  // lui aussi rattaché (il occupe le poste n°1) ET propriétaire via
  // Company.ownerId. null pour un membre individuel (freelance / startup).
  companyId            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile                    MemberProfile?
  expertProfile              ExpertProfile?
  company                    Company?                  @relation("CompanyMembers", fields: [companyId], references: [id])
  ownedCompany               Company?                  @relation("CompanyOwner")
  subscriptions              Subscription[]
  bookings                   Booking[]
  payments                   Payment[]
  serviceRequests            ServiceRequest[]
  eventRegistrations         EventRegistration[]
  notifications              Notification[]
  refreshTokens              RefreshToken[]
  sentConnectionRequests     ConnectionRequest[]       @relation("SentRequests")
  receivedConnectionRequests ConnectionRequest[]       @relation("ReceivedRequests")
  suggestionsFor             ConnectionSuggestion[]    @relation("SuggestionOwner")
  suggestionsAs              ConnectionSuggestion[]    @relation("SuggestedMember")
  expertConnectionRequests   ExpertConnectionRequest[]
  assignedLeads              Lead[]                    @relation("LeadAssignee")
  memberLeads                Lead[]                    @relation("LeadMember")
  leadActivities             LeadActivity[]            @relation("ActivityAuthor")
  appointments               Appointment[]             @relation("AppointmentAssignee")
  createdQuotes              Quote[]                   @relation("QuoteCreator")
  createdInvoices            Invoice[]                 @relation("InvoiceCreator")
  assignedServiceOrders      ServiceOrder[]            @relation("OrderAssignee")
  memberServiceOrders        ServiceOrder[]            @relation("OrderMember")
  paymentProofs              PaymentProof[]            @relation("ProofOwner")
  reviewedPaymentProofs      PaymentProof[]            @relation("ProofReviewer")

  @@index([email])
  @@index([role])
  @@index([companyId])
  @@map("users")
}

// Compte entreprise (demande client 07/09/2026) — une organisation qui
// s'inscrit via le parcours dédié « Inscrire mon entreprise », déclare un
// nombre de postes (seatLimit) et invite ses collaborateurs depuis son
// dashboard. Chaque collaborateur reçoit ses accès par email (même pattern
// que systemUsers.service.ts) et obtient son propre profil annuaire.
// La réduction tarifaire multi-postes n'est pas encore implémentée — seule
// la structure seatLimit est posée ici.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  sector    String?
  website   String?
  // Postes accordés, représentant inclus. Plafond bloquant : impossible
  // d'inviter au-delà (companies.service.ts).
  seatLimit Int      @default(1)
  ownerId   String   @unique
  siteId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])
  site    Site   @relation(fields: [siteId], references: [id])
  members User[] @relation("CompanyMembers")

  @@index([siteId])
  @@map("companies")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MemberProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  firstName      String
  lastName       String
  memberType     MemberType @default(FREELANCE)
  companyName    String?
  jobTitle       String?
  bio            String?    @db.Text
  avatarUrl      String?
  // Logo de l'entreprise du membre — géré par le membre lui-même depuis son
  // espace (/dashboard/profil), distinct de l'avatar (portrait). S'affiche
  // dans l'annuaire et le panneau admin. Toujours parler de « logo », pas de
  // « photo » (demande client 07/09/2026).
  companyLogoUrl String?
  website        String?
  linkedinUrl    String?
  // Faux par défaut : un profil n'apparaît dans l'annuaire qu'après
  // validation Admin (brief client §3.1 — la validation manuelle,
  // temporairement retirée courant août, est redemandée explicitement).
  // L'Admin bascule ce champ à true depuis /admin/validations.
  isPublic       Boolean    @default(false)
  siteId         String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site         @relation(fields: [siteId], references: [id])
  tags ProfileTag[]

  @@index([memberType])
  @@index([siteId])
  @@map("member_profiles")
}

model ExpertProfile {
  id              String   @id @default(cuid())
  userId          String?  @unique // optionnel : fiche annuaire sans compte utilisateur
  displayName     String // nom affiché (fallback quand pas de compte lié)
  photoUrl        String?
  bio             String?  @db.Text
  expertiseArea   String
  servicesOffered Json // string[] (MySQL: pas de scalar list natif)
  hourlyRate      Decimal? @db.Decimal(10, 2)
  isVerified      Boolean  @default(false)
  isPublic        Boolean  @default(true)
  order           Int      @default(0)

  user               User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionRequests ExpertConnectionRequest[]

  @@map("expert_profiles")
}

model ExpertConnectionRequest {
  id              String   @id @default(cuid())
  requesterUserId String
  expertProfileId String
  message         String   @db.Text
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  requester User          @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)
  expert    ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  @@index([requesterUserId, createdAt])
  @@index([expertProfileId, status])
  @@map("expert_connection_requests")
}

// ============================================
// LIEU & RESSOURCES
// ============================================

model Site {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberProfiles MemberProfile[]
  spaces         SpaceResource[]
  events         Event[]
  companies      Company[]

  @@map("sites")
}

model SpaceResource {
  id                  String    @id @default(cuid())
  siteId              String
  type                SpaceType
  name                String
  capacity            Int       @default(1)
  // Bureaux/domiciliation : tarif mensuel unique
  monthlyRate         Decimal?  @db.Decimal(10, 2)
  // Salles de réunion : double grille tarifaire (membre IN NETWORK vs. externe)
  hourlyRateMember    Decimal?  @db.Decimal(10, 2)
  halfDayRateMember   Decimal?  @db.Decimal(10, 2)
  dailyRateMember     Decimal?  @db.Decimal(10, 2)
  hourlyRateExternal  Decimal?  @db.Decimal(10, 2)
  halfDayRateExternal Decimal?  @db.Decimal(10, 2)
  dailyRateExternal   Decimal?  @db.Decimal(10, 2)
  photos              Json? // string[] (MySQL: pas de scalar list natif)
  isActive            Boolean   @default(true)

  site         Site                 @relation(fields: [siteId], references: [id])
  bookings     Booking[]
  requestItems ServiceRequestItem[]

  @@index([siteId, type])
  @@map("space_resources")
}

// ============================================
// ABONNEMENTS & RÉSERVATIONS
// ============================================

model MembershipPlan {
  id                   String           @id @default(cuid())
  name                 String
  billingCycle         PlanBillingCycle
  price                Decimal          @db.Decimal(10, 2)
  currency             String           @default("DZD")
  includedMeetingHours Int              @default(0)
  features             Json // liste de features affichées
  isActive             Boolean          @default(true)

  subscriptions Subscription[]
  requestItems  ServiceRequestItem[]

  @@map("membership_plans")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(PENDING_PAYMENT)
  startDate DateTime
  endDate   DateTime
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())

  user         User           @relation(fields: [userId], references: [id])
  plan         MembershipPlan @relation(fields: [planId], references: [id])
  payment      Payment?
  serviceOrder ServiceOrder?

  @@index([userId, status])
  @@map("subscriptions")
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  spaceId   String
  startAt   DateTime
  endAt     DateTime
  status    BookingStatus @default(PENDING)
  price     Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  user    User          @relation(fields: [userId], references: [id])
  space   SpaceResource @relation(fields: [spaceId], references: [id])
  payment Payment?

  @@index([spaceId, startAt, endAt])
  @@index([userId])
  @@map("bookings")
}

// ============================================
// PAIEMENTS
// ============================================

model Payment {
  id               String             @id @default(cuid())
  userId           String
  relatedType      PaymentRelatedType
  subscriptionId   String?            @unique
  bookingId        String?            @unique
  serviceRequestId String?            @unique
  amount           Decimal            @db.Decimal(10, 2)
  currency         String             @default("DZD")
  method           PaymentMethod
  status           PaymentStatus      @default(PENDING)
  providerRef      String?
  invoiceUrl       String?
  paidAt           DateTime?
  createdAt        DateTime           @default(now())

  user           User            @relation(fields: [userId], references: [id])
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  booking        Booking?        @relation(fields: [bookingId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  @@index([status])
  @@map("payments")
}

// ============================================
// SERVICES ENTREPRENEURIAUX
// ============================================

model ServiceCatalogItem {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  category     ServiceCategory
  description  String          @db.Text
  priceFrom    Decimal?        @db.Decimal(10, 2)
  pricingTiers Json? // [{ label: string, price: number }] pour les grilles à paliers
  isActive     Boolean         @default(true)

  requestItems ServiceRequestItem[]

  @@map("service_catalog_items")
}

// Demande de devis = panier : une demande (ServiceRequest) regroupe une ou
// plusieurs lignes (ServiceRequestItem) — services du catalogue, salles de
// réunion ou formules d'abonnement. userId est optionnel : un visiteur
// non-inscrit peut soumettre une demande via ses coordonnées (guest*) ; la
// contrainte "userId OU guestName+guestEmail" est appliquée au niveau
// applicatif (zod), pas en DB.
model ServiceRequest {
  id              String               @id @default(cuid())
  userId          String?
  status          ServiceRequestStatus @default(NEW)
  notes           String?              @db.Text
  // Traitement admin avant validation (demande client 07/09/2026) : l'admin
  // ajuste le devis et les détails, PUIS valide — c'est seulement à la
  // validation (confirmedAt renseigné) qu'un email de confirmation part.
  quotedAmount    Decimal?             @db.Decimal(10, 2)
  quotedCurrency  String               @default("DZD")
  adminDetails    String?              @db.Text
  confirmedAt     DateTime?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  guestCompany    String?
  assignedAdminId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    User?                @relation(fields: [userId], references: [id])
  items   ServiceRequestItem[]
  payment Payment?
  lead    Lead?

  @@index([status])
  @@map("service_requests")
}

// Ligne du panier. title / tierLabel / unitPrice / priceUnit sont un
// instantané pris à l'envoi (le catalogue peut évoluer ensuite sans réécrire
// l'historique d'un devis). unitPrice null = « sur devis » (ou grille
// horaire d'une salle, non réductible à un prix unique).
model ServiceRequestItem {
  id         String            @id @default(cuid())
  requestId  String
  targetType InquiryTargetType
  serviceId  String?
  spaceId    String?
  planId     String?
  title      String
  tierLabel  String?
  unitPrice  Decimal?          @db.Decimal(10, 2)
  // Périodicité du prix : MONTHLY / ANNUAL / DAY_PASS (formules), null pour
  // un tarif de service ponctuel.
  priceUnit  String?
  createdAt  DateTime          @default(now())

  request ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service ServiceCatalogItem? @relation(fields: [serviceId], references: [id])
  space   SpaceResource?      @relation(fields: [spaceId], references: [id])
  plan    MembershipPlan?     @relation(fields: [planId], references: [id])

  @@index([requestId])
  @@map("service_request_items")
}

// ============================================
// MISE EN RELATION (MATCHING V1)
// ============================================

model Tag {
  id       String      @id @default(cuid())
  label    String      @unique
  category TagCategory

  profileTags ProfileTag[]

  @@map("tags")
}

model ProfileTag {
  id        String          @id @default(cuid())
  profileId String
  tagId     String
  relation  TagRelationType

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     Tag           @relation(fields: [tagId], references: [id])

  @@unique([profileId, tagId, relation])
  @@map("profile_tags")
}

model ConnectionSuggestion {
  id              String           @id @default(cuid())
  userId          String
  suggestedUserId String
  score           Int
  reason          Json // ex: { type: "skill_match", detail: "Design <-> Développement" }
  status          SuggestionStatus @default(NEW)
  generatedAt     DateTime         @default(now())

  user          User @relation("SuggestionOwner", fields: [userId], references: [id])
  suggestedUser User @relation("SuggestedMember", fields: [suggestedUserId], references: [id])

  @@unique([userId, suggestedUserId])
  @@index([userId, status])
  @@map("connection_suggestions")
}

model ConnectionRequest {
  id         String                  @id @default(cuid())
  fromUserId String
  toUserId   String
  message    String                  @db.Text
  status     ConnectionRequestStatus @default(PENDING)
  createdAt  DateTime                @default(now())

  fromUser User @relation("SentRequests", fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedRequests", fields: [toUserId], references: [id])

  @@index([toUserId, status])
  @@map("connection_requests")
}

// ============================================
// ÉVÉNEMENTS
// ============================================

model Event {
  id                 String      @id @default(cuid())
  siteId             String?
  title              String
  slug               String      @unique
  description        String      @db.Text
  type               EventType
  origin             EventOrigin @default(IN_EVENT)
  status             EventStatus @default(DRAFT)
  location           String? // lieu libre, utile pour les événements externes sans Site rattaché
  startAt            DateTime
  endAt              DateTime
  capacity           Int
  coverImage         String?
  videoUrl           String? // clip de récap pour un événement déjà réalisé (bibliothèque vidéo client)
  coOrganizerName    String?
  coOrganizerLogoUrl String?
  createdAt          DateTime    @default(now())

  site          Site?               @relation(fields: [siteId], references: [id])
  registrations EventRegistration[]

  @@index([startAt])
  @@index([origin, status])
  @@map("events")
}

model GalleryImage {
  id        String           @id @default(cuid())
  url       String
  type      GalleryItemType  @default(IMAGE)
  altText   String?
  order     Int              @default(0)
  ownerType GalleryOwnerType
  ownerId   String
  createdAt DateTime         @default(now())

  @@index([ownerType, ownerId])
  @@map("gallery_images")
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String
  sector      String
  websiteUrl  String?
  description String?  @db.Text
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("partners")
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(REGISTERED)
  createdAt DateTime                @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_registrations")
}

// ============================================
// CONTENU & NOTIFICATIONS
// ============================================

model Testimonial {
  id           String   @id @default(cuid())
  authorName   String
  authorRole   String?
  content      String?  @db.Text // optionnel : un témoignage vidéo peut n'avoir aucun texte
  videoUrl     String?
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("testimonials")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "booking_confirmed", "new_suggestion", "connection_request", ...
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// Formulaire /contact — boîte de réception simple, pas de cycle de statut ni
// de rattachement à un compte (contrairement à ServiceRequest, qui cible un
// service/espace/formule précis). Un visiteur, un message.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String    @db.Text
  isRead    Boolean   @default(false)
  replyText String?   @db.Text
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  lead      Lead?

  @@index([isRead])
  @@map("contact_messages")
}

// ============================================
// CRM & CHAÎNE COMMERCIALE (demande client 20/09/2026)
// Lead → opportunité (pipeline) → devis → facture → lancement du service.
// Équipe commerciale unique ; accès via les permissions backoffice
// `crm`, `quotes`, `invoices`, `fulfilment` (comptes OFFICE_MANAGER).
// ============================================

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_SENT
  WON
  LOST
}

enum LeadSource {
  REGISTRATION
  WEBSITE_QUOTE
  CONTACT_FORM
  PHONE
  VISIT
  REFERRAL
  EVENT
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  VISIT
  SYSTEM
}

enum AppointmentType {
  CALL
  VISIT
  MEETING
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum InvoicePaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
}

enum ServiceOrderStatus {
  TO_START
  IN_PROGRESS
  DONE
  CANCELLED
}

// Compteurs de numérotation séquentielle (LD-2026-0001, DV-…, FA-…), un par
// préfixe et par année. Incrémentés dans une transaction (cf. crm/numbering.ts).
model DocumentSequence {
  key   String @id
  value Int    @default(0)

  @@map("document_sequences")
}

// Un lead devient une opportunité en avançant dans le pipeline (même fiche,
// seule l'étape change). Sources automatiques : demande de devis du site
// (serviceRequestId) et formulaire de contact (contactMessageId).
model Lead {
  id                  String     @id @default(cuid())
  reference           String     @unique
  title               String
  contactName         String
  email               String?
  phone               String?
  companyName         String?
  source              LeadSource @default(OTHER)
  stage               LeadStage  @default(NEW)
  expectedAmount      Decimal?   @db.Decimal(12, 2)
  notes               String?    @db.Text
  lostReason          String?
  nextActionAt        DateTime?
  // Automatisations : horodatage de la dernière alerte envoyée, pour ne pas
  // notifier en boucle (cf. crm/automations.service.ts).
  nextActionAlertedAt DateTime?
  dormantAlertedAt    DateTime?
  assignedToId        String?
  userId              String?
  serviceRequestId    String?    @unique
  contactMessageId    String?    @unique
  wonAt               DateTime?
  lostAt              DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  assignedTo     User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  user           User?           @relation("LeadMember", fields: [userId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  appointments   Appointment[]
  quotes         Quote[]
  invoices       Invoice[]
  serviceOrders  ServiceOrder[]

  @@index([stage])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("leads")
}

// Journal de la fiche : notes, appels, emails, visites, événements système
// (changement d'étape, relances automatiques). Sert aussi de reporting
// quotidien des commerciaux.
model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String
  authorId   String?
  type       ActivityType @default(NOTE)
  content    String       @db.Text
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([authorId, occurredAt])
  @@map("lead_activities")
}

model Appointment {
  id             String            @id @default(cuid())
  leadId         String
  assigneeId     String?
  type           AppointmentType   @default(MEETING)
  status         AppointmentStatus @default(SCHEDULED)
  startAt        DateTime
  endAt          DateTime?
  location       String?
  notes          String?           @db.Text
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation("AppointmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([assigneeId, startAt])
  @@map("appointments")
}

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique
  leadId         String
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?
  notes          String?     @db.Text
  vatRate        Decimal     @default(19) @db.Decimal(5, 2)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  lastReminderAt DateTime?
  reminderCount  Int         @default(0)
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     QuoteLine[]
  invoices  Invoice[]
  proofs    PaymentProof[]

  @@index([leadId])
  @@index([status])
  @@map("quotes")
}

// Les lignes gardent un instantané (description, prix) : serviceId / planId /
// spaceId ne sont que des repères vers le catalogue (pas de clé étrangère —
// le catalogue peut évoluer sans réécrire un devis déjà envoyé).
model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  position    Int     @default(0)
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  serviceId   String?
  planId      String?
  spaceId     String?
  tierLabel   String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_lines")
}

// Modèles de devis (automatisation) : un devis pré-rempli en un clic.
// lines = [{ description, quantity, unitPrice, serviceSlug?, tierLabel? }]
model QuoteTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  validityDays Int      @default(15)
  notes        String?  @db.Text
  lines        Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("quote_templates")
}

// Le numéro n'est attribué qu'à l'émission (statut DRAFT → SENT) : une
// numérotation continue sans trous, y compris si un brouillon est supprimé.
model Invoice {
  id              String                @id @default(cuid())
  number          String?               @unique
  leadId          String?
  quoteId         String?
  status          InvoiceStatus         @default(DRAFT)
  customerName    String
  customerCompany String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerNif     String?
  customerRc      String?
  customerAi      String?
  issueDate       DateTime?
  dueDate         DateTime?
  vatRate         Decimal               @default(19) @db.Decimal(5, 2)
  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  vatAmount       Decimal               @default(0) @db.Decimal(12, 2)
  total           Decimal               @default(0) @db.Decimal(12, 2)
  currency        String                @default("DZD")
  notes           String?               @db.Text
  paidAt          DateTime?
  paymentMethod   InvoicePaymentMethod?
  paymentRef      String?
  lastReminderAt  DateTime?
  reminderCount   Int                   @default(0)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  serviceOrders ServiceOrder[]
  proofs        PaymentProof[]

  @@index([status])
  @@index([leadId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  position    Int     @default(0)
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  serviceId   String?
  planId      String?
  spaceId     String?
  tierLabel   String?

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@index([invoiceId])
  @@map("invoice_lines")
}

// Lancement du service : une commande de service par ligne de facture payée,
// avec sa checklist. Une ligne « formule d'abonnement » active en plus
// l'abonnement du membre rattaché (subscriptionId).
model ServiceOrder {
  id             String             @id @default(cuid())
  invoiceId      String
  invoiceLineId  String?
  leadId         String?
  userId         String?
  title          String
  status         ServiceOrderStatus @default(TO_START)
  assignedToId   String?
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?            @db.Text
  subscriptionId String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  invoice      Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceLine  InvoiceLine?       @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  lead         Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user         User?              @relation("OrderMember", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo   User?              @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tasks        ServiceOrderTask[]

  @@index([status])
  @@index([invoiceId])
  @@map("service_orders")
}

model ServiceOrderTask {
  id       String    @id @default(cuid())
  orderId  String
  position Int       @default(0)
  title    String
  isDone   Boolean   @default(false)
  doneAt   DateTime?

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("service_order_tasks")
}

// ============================================
// JUSTIFICATIFS DE PAIEMENT (demande client 20/09/2026)
// Envoyés par le membre depuis « Situation du compte » ; vérifiés par
// l'équipe, qui enregistre le paiement et valide le compte. Les fichiers
// sont stockés hors du dossier public (jamais servis en statique) et
// relus via une route authentifiée.
// ============================================

enum PaymentProofStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PaymentProof {
  id           String             @id @default(cuid())
  userId       String
  quoteId      String?
  invoiceId    String?
  // Chemin relatif au dossier privé des justificatifs (jamais une URL).
  filePath     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  amount       Decimal?           @db.Decimal(12, 2)
  reference    String?
  note         String?            @db.Text
  status       PaymentProofStatus @default(PENDING)
  reviewNote   String?            @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  user       User     @relation("ProofOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  quote      Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("payment_proofs")
}
