// IN NETWORK — Schéma de données (MVP V1)
// Adapté du CDC Technique §4 pour MySQL (XAMPP en local, VPS en production)
// Différences vs. CDC original (pensé pour PostgreSQL) :
//  - String[] non supporté par Prisma sur MySQL -> remplacé par Json
//  - Account/Session/VerificationToken (NextAuth) remplacés par RefreshToken (auth JWT maison)
//  - Champs de vérification email / reset password ajoutés directement sur User

// Migration Prisma 7 (§0 brief) : générateur renommé "prisma-client" avec un
// output explicite hors node_modules ; le driver adapter (@prisma/adapter-mariadb,
// cf. lib/prisma.ts) porte désormais la connexion réelle — l'URL de
// migration/introspection CLI vit dans prisma.config.ts, plus ici.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  // Compte staff à droits restreints (demande client 07/09/2026) : accès au
  // backoffice borné par User.permissions (lecture/écriture par bloc). Créé
  // depuis /admin/compte (« Utilisateurs système ») par un SUPER_ADMIN.
  OFFICE_MANAGER
  // Équipe commerciale (demande client 19/10/2026). Comme OFFICE_MANAGER, leurs
  // accès au backoffice sont bornés par User.permissions. Le responsable
  // commercial qualifie/valide les leads et les assigne ; un commercial ne voit
  // que les leads qui lui sont assignés (cf. crm/scope.ts).
  SALES_MANAGER
  SALES_AGENT
  // Support administratif (processus v1.3) : réalise les démarches de création
  // d'entreprise et de domiciliation. Ne voit que les services du pôle
  // « Création d'entreprise » (cf. crm/fulfilment.service.ts).
  ADMIN_SUPPORT
  MEMBER
}

// Commercial de la Sales Team (processus v1.3) : le sédentaire traite à
// distance (digital, entrants, diaspora, offres simples), le terrain les
// entreprises et comptes à fort potentiel. Sert à l'attribution des leads.
enum SalesProfile {
  SEDENTARY
  FIELD
}

enum MemberType {
  FREELANCE
  STARTUP
  ENTREPRISE
}

enum SpaceType {
  DESK
  PRIVATE_OFFICE
  MEETING_ROOM
}

enum PlanBillingCycle {
  DAY_PASS
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentRelatedType {
  SUBSCRIPTION
  BOOKING
  SERVICE_REQUEST
}

enum ServiceCategory {
  DOMICILIATION
  CREATION_ENTREPRISE
  ADMINISTRATION
  COMPTABILITE
  JURIDIQUE
  MARKETING
  SECRETARIAT
  // Offres regroupées par besoin (Starter, Builder…), packs diaspora et
  // incubateur — catalogue « Offre de service commerciale » (19/10/2026).
  OFFRE
  DIASPORA
  INCUBATION
  AUTRE
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TagCategory {
  SKILL
  SECTOR
}

enum TagRelationType {
  OFFER
  NEED
}

enum SuggestionStatus {
  NEW
  VIEWED
  CONTACTED
  DISMISSED
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EventType {
  CONFERENCE
  ATELIER
  NETWORKING
  MASTERCLASS
}

// Catégorie d'organisation de l'événement (distincte du type CONFERENCE/ATELIER/...)
enum EventOrigin {
  IN_EVENT // organisé en interne par IN NETWORK
  EXTERNAL // événement externe relayé sur la plateforme
  CO_ORGANIZED // co-organisé avec un partenaire
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EventRegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum GalleryOwnerType {
  EVENT
  SITE
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

// Nature d'une ligne du panier de devis (service du catalogue, salle de
// réunion ou formule d'abonnement) — un seul modèle de demande, un seul
// dashboard admin, quelle que soit la nature du catalogue visé.
enum InquiryTargetType {
  SERVICE
  SPACE
  PLAN
}

// ============================================
// IDENTITÉ
// ============================================

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  emailVerified        DateTime?
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  passwordHash         String
  phone                String?
  role                 Role          @default(MEMBER)
  // Permissions backoffice granulaires pour les rôles staff restreints
  // (OFFICE_MANAGER) : { "<bloc>": "read" | "write" }. Ignoré pour
  // SUPER_ADMIN / ADMIN (accès total) et MEMBER (pas de backoffice).
  permissions          Json?
  // Nom affiché pour les comptes staff (qui n'ont pas de MemberProfile).
  displayName          String?
  // Commerciaux (SALES_AGENT) : sédentaire ou terrain ; isExternal = prestataire
  // de la Sales Team externe (processus v1.3).
  salesProfile         SalesProfile?
  isExternal           Boolean       @default(false)
  // Membre : interlocuteur unique de l'équipe, de l'activation au
  // renouvellement (processus v1.3, « référent membre »). Désigné à l'activation.
  referentId           String?
  isActive             Boolean       @default(true)
  // Rattachement à un compte entreprise (demande client 07/09/2026) : un
  // collaborateur invité depuis le dashboard d'une entreprise porte le
  // companyId de celle-ci. Le représentant qui a inscrit l'entreprise est
  // lui aussi rattaché (il occupe le poste n°1) ET propriétaire via
  // Company.ownerId. null pour un membre individuel (freelance / startup).
  companyId            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  profile                    MemberProfile?
  expertProfile              ExpertProfile?
  company                    Company?                  @relation("CompanyMembers", fields: [companyId], references: [id])
  referent                   User?                     @relation("MemberReferent", fields: [referentId], references: [id], onDelete: SetNull)
  referredMembers            User[]                    @relation("MemberReferent")
  ownedCompany               Company?                  @relation("CompanyOwner")
  subscriptions              Subscription[]
  bookings                   Booking[]
  payments                   Payment[]
  serviceRequests            ServiceRequest[]
  eventRegistrations         EventRegistration[]
  notifications              Notification[]
  refreshTokens              RefreshToken[]
  sentConnectionRequests     ConnectionRequest[]       @relation("SentRequests")
  receivedConnectionRequests ConnectionRequest[]       @relation("ReceivedRequests")
  sentMessages               Message[]                 @relation("MessageSender")
  suggestionsFor             ConnectionSuggestion[]    @relation("SuggestionOwner")
  suggestionsAs              ConnectionSuggestion[]    @relation("SuggestedMember")
  expertConnectionRequests   ExpertConnectionRequest[]
  assignedLeads              Lead[]                    @relation("LeadAssignee")
  salesLeads                 Lead[]                    @relation("LeadSalesAgent")
  referredLeads              Lead[]                    @relation("LeadReferrer")
  circuitChanges             LeadCircuitChange[]       @relation("CircuitChangeAuthor")
  approvedQuotes             Quote[]                   @relation("QuoteApprover")
  validatedServiceOrders     ServiceOrder[]            @relation("OrderValidator")
  memberDocuments            MemberDocument[]          @relation("DocumentOwner")
  uploadedDocuments          MemberDocument[]          @relation("DocumentUploader")
  commissions                Commission[]              @relation("CommissionBeneficiary")
  qualifiedLeads             Lead[]                    @relation("LeadQualifier")
  memberLeads                Lead[]                    @relation("LeadMember")
  leadActivities             LeadActivity[]            @relation("ActivityAuthor")
  appointments               Appointment[]             @relation("AppointmentAssignee")
  createdQuotes              Quote[]                   @relation("QuoteCreator")
  createdInvoices            Invoice[]                 @relation("InvoiceCreator")
  assignedServiceOrders      ServiceOrder[]            @relation("OrderAssignee")
  memberServiceOrders        ServiceOrder[]            @relation("OrderMember")
  paymentProofs              PaymentProof[]            @relation("ProofOwner")
  reviewedPaymentProofs      PaymentProof[]            @relation("ProofReviewer")

  @@index([email])
  @@index([role])
  @@index([companyId])
  @@index([referentId])
  @@map("users")
}

// Compte entreprise (demande client 07/09/2026) — une organisation qui
// s'inscrit via le parcours dédié « Inscrire mon entreprise », déclare un
// nombre de postes (seatLimit) et invite ses collaborateurs depuis son
// dashboard. Chaque collaborateur reçoit ses accès par email (même pattern
// que systemUsers.service.ts) et obtient son propre profil annuaire.
// La réduction tarifaire multi-postes n'est pas encore implémentée — seule
// la structure seatLimit est posée ici.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  sector    String?
  website   String?
  // Postes accordés, représentant inclus. Plafond bloquant : impossible
  // d'inviter au-delà (companies.service.ts).
  seatLimit Int      @default(1)
  ownerId   String   @unique
  siteId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])
  site    Site   @relation(fields: [siteId], references: [id])
  members User[] @relation("CompanyMembers")

  @@index([siteId])
  @@map("companies")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MemberProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  firstName      String
  lastName       String
  memberType     MemberType @default(FREELANCE)
  companyName    String?
  jobTitle       String?
  bio            String?    @db.Text
  avatarUrl      String?
  // Logo de l'entreprise du membre — géré par le membre lui-même depuis son
  // espace (/dashboard/profil), distinct de l'avatar (portrait). S'affiche
  // dans l'annuaire et le panneau admin. Toujours parler de « logo », pas de
  // « photo » (demande client 07/09/2026).
  companyLogoUrl String?
  // Ville / wilaya — localisation affichée dans l'annuaire (brief §4.3).
  city           String?
  website        String?
  linkedinUrl    String?
  // Faux par défaut : un profil n'apparaît dans l'annuaire qu'après
  // validation Admin (brief client §3.1 — la validation manuelle,
  // temporairement retirée courant août, est redemandée explicitement).
  // L'Admin bascule ce champ à true depuis /admin/validations.
  isPublic       Boolean    @default(false)
  siteId         String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site         @relation(fields: [siteId], references: [id])
  tags ProfileTag[]

  @@index([memberType])
  @@index([siteId])
  @@map("member_profiles")
}

model ExpertProfile {
  id              String   @id @default(cuid())
  userId          String?  @unique // optionnel : fiche annuaire sans compte utilisateur
  displayName     String // nom affiché (fallback quand pas de compte lié)
  photoUrl        String?
  bio             String?  @db.Text
  expertiseArea   String
  servicesOffered Json // string[] (MySQL: pas de scalar list natif)
  hourlyRate      Decimal? @db.Decimal(10, 2)
  isVerified      Boolean  @default(false)
  isPublic        Boolean  @default(true)
  order           Int      @default(0)

  user               User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionRequests ExpertConnectionRequest[]

  @@map("expert_profiles")
}

model ExpertConnectionRequest {
  id              String   @id @default(cuid())
  requesterUserId String
  expertProfileId String
  message         String   @db.Text
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  requester User          @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)
  expert    ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)

  @@index([requesterUserId, createdAt])
  @@index([expertProfileId, status])
  @@map("expert_connection_requests")
}

// ============================================
// LIEU & RESSOURCES
// ============================================

model Site {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberProfiles MemberProfile[]
  spaces         SpaceResource[]
  events         Event[]
  companies      Company[]

  @@map("sites")
}

model SpaceResource {
  id                  String    @id @default(cuid())
  siteId              String
  type                SpaceType
  name                String
  // Capacité : « 6 à 8 personnes » → capacityMin 6, capacity 8 (capacity seule = « jusqu'à »).
  capacity            Int       @default(1)
  capacityMin         Int?
  // Descriptif court et factuel (équipements), affiché au membre et sur le site.
  description         String?   @db.Text
  // Bureaux/domiciliation : tarif mensuel unique
  monthlyRate         Decimal?  @db.Decimal(10, 2)
  // Salles de réunion : double grille tarifaire (membre IN NETWORK vs. externe)
  hourlyRateMember    Decimal?  @db.Decimal(10, 2)
  halfDayRateMember   Decimal?  @db.Decimal(10, 2)
  dailyRateMember     Decimal?  @db.Decimal(10, 2)
  hourlyRateExternal  Decimal?  @db.Decimal(10, 2)
  halfDayRateExternal Decimal?  @db.Decimal(10, 2)
  dailyRateExternal   Decimal?  @db.Decimal(10, 2)
  photos              Json? // string[] (MySQL: pas de scalar list natif)
  isActive            Boolean   @default(true)

  site          Site                 @relation(fields: [siteId], references: [id])
  bookings      Booking[]
  requestItems  ServiceRequestItem[]
  // Bureaux privatifs : services du panier auxquels le bureau est attribué.
  serviceOrders ServiceOrder[]

  @@index([siteId, type])
  @@map("space_resources")
}

// ============================================
// ABONNEMENTS & RÉSERVATIONS
// ============================================

model MembershipPlan {
  id                   String           @id @default(cuid())
  name                 String
  billingCycle         PlanBillingCycle
  price                Decimal          @db.Decimal(10, 2)
  currency             String           @default("DZD")
  includedMeetingHours Int              @default(0)
  features             Json // liste de features affichées
  isActive             Boolean          @default(true)

  subscriptions   Subscription[]
  requestItems    ServiceRequestItem[]
  commissionRules CommissionRule[]

  @@map("membership_plans")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(PENDING_PAYMENT)
  startDate DateTime
  endDate   DateTime
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())

  user         User           @relation(fields: [userId], references: [id])
  plan         MembershipPlan @relation(fields: [planId], references: [id])
  payment      Payment?
  serviceOrder ServiceOrder?

  @@index([userId, status])
  @@map("subscriptions")
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  spaceId   String
  startAt   DateTime
  endAt     DateTime
  status    BookingStatus @default(PENDING)
  price     Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  user    User          @relation(fields: [userId], references: [id])
  space   SpaceResource @relation(fields: [spaceId], references: [id])
  payment Payment?

  @@index([spaceId, startAt, endAt])
  @@index([userId])
  @@map("bookings")
}

// ============================================
// PAIEMENTS
// ============================================

model Payment {
  id               String             @id @default(cuid())
  userId           String
  relatedType      PaymentRelatedType
  subscriptionId   String?            @unique
  bookingId        String?            @unique
  serviceRequestId String?            @unique
  amount           Decimal            @db.Decimal(10, 2)
  currency         String             @default("DZD")
  method           PaymentMethod
  status           PaymentStatus      @default(PENDING)
  providerRef      String?
  invoiceUrl       String?
  paidAt           DateTime?
  createdAt        DateTime           @default(now())

  user           User            @relation(fields: [userId], references: [id])
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  booking        Booking?        @relation(fields: [bookingId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  @@index([status])
  @@map("payments")
}

// ============================================
// SERVICES ENTREPRENEURIAUX
// ============================================

model ServiceCatalogItem {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  category       ServiceCategory
  description    String          @db.Text
  priceFrom      Decimal?        @db.Decimal(10, 2)
  pricingTiers   Json? // [{ label: string, price: number }] pour les grilles à paliers
  // Processus v1.3 : pôle qui livre le service, filiale IN Group concernée
  // (pôle IN_GROUP) et durée de validité (null = service sans échéance, comme
  // une création d'entreprise). « Tarif défini » vs « sur devis » se déduit
  // des prix (priceFrom / pricingTiers), sans champ dédié.
  pole           DeliveryPole    @default(SPACES)
  subsidiary     String?
  durationMonths Int?
  isActive       Boolean         @default(true)

  requestItems    ServiceRequestItem[]
  commissionRules CommissionRule[]

  @@map("service_catalog_items")
}

// Demande de devis = panier : une demande (ServiceRequest) regroupe une ou
// plusieurs lignes (ServiceRequestItem) — services du catalogue, salles de
// réunion ou formules d'abonnement. userId est optionnel : un visiteur
// non-inscrit peut soumettre une demande via ses coordonnées (guest*) ; la
// contrainte "userId OU guestName+guestEmail" est appliquée au niveau
// applicatif (zod), pas en DB.
model ServiceRequest {
  id              String               @id @default(cuid())
  userId          String?
  status          ServiceRequestStatus @default(NEW)
  notes           String?              @db.Text
  // Traitement admin avant validation (demande client 07/09/2026) : l'admin
  // ajuste le devis et les détails, PUIS valide — c'est seulement à la
  // validation (confirmedAt renseigné) qu'un email de confirmation part.
  quotedAmount    Decimal?             @db.Decimal(10, 2)
  quotedCurrency  String               @default("DZD")
  adminDetails    String?              @db.Text
  confirmedAt     DateTime?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  guestCompany    String?
  assignedAdminId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    User?                @relation(fields: [userId], references: [id])
  items   ServiceRequestItem[]
  payment Payment?
  lead    Lead?

  @@index([status])
  @@map("service_requests")
}

// Ligne du panier. title / tierLabel / unitPrice / priceUnit sont un
// instantané pris à l'envoi (le catalogue peut évoluer ensuite sans réécrire
// l'historique d'un devis). unitPrice null = « sur devis » (ou grille
// horaire d'une salle, non réductible à un prix unique).
model ServiceRequestItem {
  id         String            @id @default(cuid())
  requestId  String
  targetType InquiryTargetType
  serviceId  String?
  spaceId    String?
  planId     String?
  title      String
  tierLabel  String?
  unitPrice  Decimal?          @db.Decimal(10, 2)
  // Périodicité du prix : MONTHLY / ANNUAL / DAY_PASS (formules), null pour
  // un tarif de service ponctuel.
  priceUnit  String?
  createdAt  DateTime          @default(now())

  request ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service ServiceCatalogItem? @relation(fields: [serviceId], references: [id])
  space   SpaceResource?      @relation(fields: [spaceId], references: [id])
  plan    MembershipPlan?     @relation(fields: [planId], references: [id])

  @@index([requestId])
  @@map("service_request_items")
}

// ============================================
// MISE EN RELATION (MATCHING V1)
// ============================================

model Tag {
  id       String      @id @default(cuid())
  label    String      @unique
  category TagCategory
  // Famille d'appartenance (« Informatique & digital », « Commerce »…) : sert à
  // grouper la liste dans le sélecteur de compétences / secteurs. Null pour une
  // étiquette saisie librement par un membre.
  group    String?

  profileTags ProfileTag[]

  @@index([category, group])
  @@map("tags")
}

model ProfileTag {
  id        String          @id @default(cuid())
  profileId String
  tagId     String
  relation  TagRelationType

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     Tag           @relation(fields: [tagId], references: [id])

  @@unique([profileId, tagId, relation])
  @@map("profile_tags")
}

model ConnectionSuggestion {
  id              String           @id @default(cuid())
  userId          String
  suggestedUserId String
  score           Int
  reason          Json // ex: { type: "skill_match", detail: "Design <-> Développement" }
  status          SuggestionStatus @default(NEW)
  generatedAt     DateTime         @default(now())

  user          User @relation("SuggestionOwner", fields: [userId], references: [id])
  suggestedUser User @relation("SuggestedMember", fields: [suggestedUserId], references: [id])

  @@unique([userId, suggestedUserId])
  @@index([userId, status])
  @@map("connection_suggestions")
}

model ConnectionRequest {
  id         String                  @id @default(cuid())
  fromUserId String
  toUserId   String
  message    String                  @db.Text
  status     ConnectionRequestStatus @default(PENDING)
  createdAt  DateTime                @default(now())

  fromUser User      @relation("SentRequests", fields: [fromUserId], references: [id])
  toUser   User      @relation("ReceivedRequests", fields: [toUserId], references: [id])
  messages Message[]

  @@index([toUserId, status])
  @@map("connection_requests")
}

// Messagerie entre membres (demande client 19/10/2026) : une mise en relation
// acceptée ouvre une conversation privée. Le fil de discussion EST la demande
// acceptée (connectionId) — pas de table « conversation » à synchroniser. Un
// message est lu quand son destinataire ouvre le fil (readAt).
model Message {
  id           String    @id @default(cuid())
  connectionId String
  senderId     String
  body         String    @db.Text
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  connection ConnectionRequest @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ============================================
// ÉVÉNEMENTS
// ============================================

model Event {
  id                 String      @id @default(cuid())
  siteId             String?
  title              String
  slug               String      @unique
  description        String      @db.Text
  type               EventType
  origin             EventOrigin @default(IN_EVENT)
  status             EventStatus @default(DRAFT)
  location           String? // lieu libre, utile pour les événements externes sans Site rattaché
  startAt            DateTime
  endAt              DateTime
  capacity           Int
  coverImage         String?
  videoUrl           String? // clip de récap pour un événement déjà réalisé (bibliothèque vidéo client)
  coOrganizerName    String?
  coOrganizerLogoUrl String?
  createdAt          DateTime    @default(now())

  site          Site?               @relation(fields: [siteId], references: [id])
  registrations EventRegistration[]

  @@index([startAt])
  @@index([origin, status])
  @@map("events")
}

model GalleryImage {
  id        String           @id @default(cuid())
  url       String
  type      GalleryItemType  @default(IMAGE)
  altText   String?
  order     Int              @default(0)
  ownerType GalleryOwnerType
  ownerId   String
  createdAt DateTime         @default(now())

  @@index([ownerType, ownerId])
  @@map("gallery_images")
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String
  sector      String
  websiteUrl  String?
  description String?  @db.Text
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("partners")
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(REGISTERED)
  createdAt DateTime                @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_registrations")
}

// ============================================
// CONTENU & NOTIFICATIONS
// ============================================

model Testimonial {
  id           String   @id @default(cuid())
  authorName   String
  authorRole   String?
  content      String?  @db.Text // optionnel : un témoignage vidéo peut n'avoir aucun texte
  videoUrl     String?
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("testimonials")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "booking_confirmed", "new_suggestion", "connection_request", ...
  title     String
  body      String   @db.Text
  // Page à ouvrir au clic (ex. /admin/crm/leads/<id>) ; null = déduite du type côté interface.
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// Formulaire /contact — boîte de réception simple, pas de cycle de statut ni
// de rattachement à un compte (contrairement à ServiceRequest, qui cible un
// service/espace/formule précis). Un visiteur, un message.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  // Page Contact refondue (audit 25/10/2026) : téléphone facultatif et sujet.
  phone     String?
  subject   String?
  message   String    @db.Text
  isRead    Boolean   @default(false)
  replyText String?   @db.Text
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  lead      Lead?

  @@index([isRead])
  @@map("contact_messages")
}

// ============================================
// CRM & CHAÎNE COMMERCIALE (demande client 20/09/2026)
// Lead → opportunité (pipeline) → devis → facture → lancement du service.
// Équipe commerciale unique ; accès via les permissions backoffice
// `crm`, `quotes`, `invoices`, `fulfilment` (comptes OFFICE_MANAGER).
// ============================================

// Parcours d'un lead — processus commercial v1.3 (23/10/2026). Une seule fiche
// du premier contact au paiement ; la suite (activation, livraison, échéance)
// vit sur les services du membre (ServiceOrder).
//   REGISTERED      Lead enregistré : en attente d'aiguillage (circuit null) ou
//                   d'attribution à un commercial (circuit 1)
//   ASSIGNED        Attribué (Sales, circuit 1) / Pris en charge (Office Manager, circuit 2)
//   QUALIFIED       Qualifié : besoin compris, offre pressentie
//   FOLLOW_UP       Relance en cours (pas encore de visite / visio)
//   VISIT_CONFIRMED Visite / visio confirmée : en circuit 1, le dossier passe à l'Office Manager
//   QUOTE_SENT      Devis envoyé
//   CONFIRMED       Devis confirmé par le client : l'Office Manager organise le paiement
//   PAID            Paiement confirmé : client gagné, la fiche devient fiche membre
//   LOST            Perdu / clôturé
// Les transitions autorisées par profil sont décrites dans crm/workflow.ts.
enum LeadStage {
  REGISTERED
  ASSIGNED
  QUALIFIED
  FOLLOW_UP
  VISIT_CONFIRMED
  QUOTE_SENT
  CONFIRMED
  PAID
  LOST
}

// Circuit 1 : par la Sales Team (responsable commercial → commercial) jusqu'à
// la visite confirmée, puis l'Office Manager. Circuit 2 : direct Office Manager.
// null = lead à aiguiller. Figé une fois choisi : le changer passe par une
// passerelle consignée (LeadCircuitChange).
enum LeadCircuit {
  SALES_TEAM
  OFFICE_MANAGER
}

// Les quatre pipelines d'entrée du processus v1.3.
enum LeadPipeline {
  DIGITAL // Digital et entrant
  COMMUNITY // Événements et communauté
  PARTNERS // Partenaires et recommandations
  DIASPORA_DIRECT // Diaspora et contacts directs
}

// Canal précis, rattaché à un pipeline (cf. crm/workflow.ts CHANNEL_PIPELINE).
enum LeadChannel {
  LINKEDIN
  SOCIAL_MEDIA
  WEBSITE
  ADVERTISING
  COLD_MAILING
  WORKSHOP
  OPEN_DAY
  IN_TALK
  MEMBER_REFERRAL
  ACCOUNTANT
  LAWYER
  SCHOOL
  INCUBATOR
  LMIG_SUBSIDIARY
  DIASPORA_FRANCE
  DIASPORA_CANADA
  DIASPORA_UAE
  WHATSAPP
  DIRECT_MESSAGE
  WALK_IN
  PHONE
}

// Nature de l'affaire : nouveau client, service supplémentaire demandé par un
// membre, ou renouvellement d'un service arrivant à échéance.
enum LeadKind {
  NEW_BUSINESS
  EXTENSION
  RENEWAL
}

// Température du lead, posée à la qualification.
enum LeadPriority {
  COLD
  WARM
  HOT
}

// Comment la fiche a été créée (origine technique). Le canal marketing est
// porté par pipeline / channel.
enum LeadSource {
  REGISTRATION // inscription sur le site
  WEBSITE_QUOTE // demande de devis du site
  CONTACT_FORM // formulaire de contact
  MEMBER_SPACE // demande ou renouvellement depuis l'espace membre
  MEMBER_REFERRAL // recommandation envoyée par un membre depuis son espace
  AD_FORM // formulaire publicitaire des réseaux (Facebook, Instagram, LinkedIn), reçu par webhook
  MANUAL // saisie par l'équipe
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  VISIT
  SYSTEM
}

enum AppointmentType {
  CALL
  VISIT
  VIDEO
  TRIAL_DAY
  MEETING
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  // Devis sur mesure soumis à validation (responsable commercial ou Direction)
  // avant de pouvoir être envoyé.
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// SENT = facture proforma envoyée (numéro PF-…), à payer. PAID = facture
// définitive (numéro FA-… attribué au paiement). REFUNDED = payée puis
// remboursée (les commissions sont reprises).
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  REFUNDED
}

// Remise sur le total d'un devis / d'une facture.
enum DiscountType {
  PERCENT
  AMOUNT
}

enum QuoteConfirmation {
  PLATFORM
  EMAIL
}

enum InvoicePaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
}

// Service vendu (panier du membre) : À lancer → Activation en cours → En
// attente de validation (livrable prêt) ⇄ Ajustement demandé → Livré / Actif
// (DONE). « À renouveler », « Expiré », « Renouvelé » se déduisent des dates.
enum ServiceOrderStatus {
  TO_START
  IN_PROGRESS
  AWAITING_VALIDATION
  ADJUSTMENT_REQUESTED
  DONE
  CANCELLED
}

// Pôles de livraison du processus v1.3.
enum DeliveryPole {
  SPACES // Espaces et domiciliation (Office Manager)
  COMPANY_CREATION // Création d'entreprise (Support administratif)
  IN_GROUP // Solutions IN Group (filiales)
}

// Compteurs de numérotation séquentielle (LD-2026-0001, DV-…, FA-…), un par
// préfixe et par année. Incrémentés dans une transaction (cf. crm/numbering.ts).
model DocumentSequence {
  key   String @id
  value Int    @default(0)

  @@map("document_sequences")
}

// Fiche lead unique (processus v1.3) : source, canal, circuit et intervenants
// tracés de l'entrée au paiement ; au paiement elle devient la fiche membre
// (userId), sans perdre cet historique. Sources automatiques : inscription,
// demande de devis du site (serviceRequestId), formulaire de contact
// (contactMessageId), demandes et renouvellements depuis l'espace membre.
model Lead {
  id                  String        @id @default(cuid())
  reference           String        @unique
  title               String
  contactName         String
  email               String?
  phone               String?
  companyName         String?
  source              LeadSource    @default(MANUAL)
  kind                LeadKind      @default(NEW_BUSINESS)
  pipeline            LeadPipeline?
  channel             LeadChannel?
  // Précision libre sur le canal (nom de l'événement, du cabinet partenaire…).
  channelDetail       String?
  circuit             LeadCircuit?
  stage               LeadStage     @default(REGISTERED)
  expectedAmount      Decimal?      @db.Decimal(12, 2)
  notes               String?       @db.Text
  lostReason          String?
  // Qualification (phase 2) : profil, projet, étape, besoin réel, offre
  // pressentie, température.
  priority            LeadPriority?
  qualification       Json?
  offerInterest       String?
  qualifiedAt         DateTime?
  qualifiedById       String?
  // Intervenant en charge du dossier à cet instant (commercial, puis Office
  // Manager après la transmission ; Office Manager en circuit 2).
  assignedToId        String?
  assignedAt          DateTime?
  // Commercial de la Sales Team (circuit 1). Figé à la transmission : c'est
  // le « closer » pour la commission ; il garde un accès en lecture au dossier.
  salesAgentId        String?
  dispatchedAt        DateTime?
  handedOverAt        DateTime?
  followUpCount       Int           @default(0)
  followUpReturnedAt  DateTime?
  nextActionAt        DateTime?
  // Automatisations : horodatage de la dernière alerte envoyée, pour ne pas
  // notifier en boucle (cf. crm/automations.service.ts).
  nextActionAlertedAt DateTime?
  dormantAlertedAt    DateTime?
  userId              String?
  // Extension / renouvellement : rattaché à la fiche d'origine du membre.
  parentLeadId        String?
  // Membre qui a recommandé ce contact (parrainage).
  referrerUserId      String?
  serviceRequestId    String?       @unique
  contactMessageId    String?       @unique
  confirmedAt         DateTime?
  // Paiement confirmé (client gagné).
  wonAt               DateTime?
  lostAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  assignedTo     User?               @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  salesAgent     User?               @relation("LeadSalesAgent", fields: [salesAgentId], references: [id], onDelete: SetNull)
  qualifiedBy    User?               @relation("LeadQualifier", fields: [qualifiedById], references: [id], onDelete: SetNull)
  user           User?               @relation("LeadMember", fields: [userId], references: [id], onDelete: SetNull)
  referrer       User?               @relation("LeadReferrer", fields: [referrerUserId], references: [id], onDelete: SetNull)
  parentLead     Lead?               @relation("LeadParent", fields: [parentLeadId], references: [id], onDelete: SetNull)
  childLeads     Lead[]              @relation("LeadParent")
  serviceRequest ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  contactMessage ContactMessage?     @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  appointments   Appointment[]
  quotes         Quote[]
  invoices       Invoice[]
  serviceOrders  ServiceOrder[]
  circuitChanges LeadCircuitChange[]
  commissions    Commission[]

  @@index([stage])
  @@index([circuit, stage])
  @@index([assignedToId])
  @@index([salesAgentId])
  @@index([email])
  @@index([phone])
  @@index([userId])
  @@index([createdAt])
  @@map("leads")
}

// Passerelle entre circuits (processus v1.3) : tout changement de circuit
// après l'aiguillage est consigné avec son motif — c'est ce qui évite les
// doubles commissions.
model LeadCircuitChange {
  id          String       @id @default(cuid())
  leadId      String
  fromCircuit LeadCircuit?
  toCircuit   LeadCircuit
  reason      String       @db.Text
  authorId    String?
  createdAt   DateTime     @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation("CircuitChangeAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_circuit_changes")
}

// Journal de la fiche : notes, appels, emails, visites, événements système
// (changement d'étape, relances automatiques). Sert aussi de reporting
// quotidien des commerciaux.
model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String
  authorId   String?
  type       ActivityType @default(NOTE)
  content    String       @db.Text
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([authorId, occurredAt])
  @@map("lead_activities")
}

model Appointment {
  id             String            @id @default(cuid())
  leadId         String
  assigneeId     String?
  type           AppointmentType   @default(MEETING)
  status         AppointmentStatus @default(SCHEDULED)
  startAt        DateTime
  endAt          DateTime?
  location       String?
  notes          String?           @db.Text
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation("AppointmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([assigneeId, startAt])
  @@map("appointments")
}

model Quote {
  id             String             @id @default(cuid())
  number         String             @unique
  leadId         String
  status         QuoteStatus        @default(DRAFT)
  validUntil     DateTime?
  notes          String?            @db.Text
  vatRate        Decimal            @default(19) @db.Decimal(5, 2)
  // Remise sur le total HT (en % ou en DA), en plus des remises de ligne.
  // subtotal = total HT net ; discountAmount = total des remises accordées.
  discountType   DiscountType?
  discountValue  Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount Decimal            @default(0) @db.Decimal(12, 2)
  subtotal       Decimal            @default(0) @db.Decimal(12, 2)
  total          Decimal            @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  lastReminderAt DateTime?
  reminderCount  Int                @default(0)
  // Devis sur mesure (processus v1.3) : validé par le responsable commercial
  // ou la Direction avant l'envoi. Modifier les lignes annule la validation.
  approvedAt     DateTime?
  approvedById   String?
  // Comment le client a confirmé : depuis son espace, ou par e-mail (consigné
  // par l'intervenant).
  confirmedVia   QuoteConfirmation?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?          @relation("QuoteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      QuoteLine[]
  invoices   Invoice[]
  proofs     PaymentProof[]

  @@index([leadId])
  @@index([status])
  @@map("quotes")
}

// Les lignes gardent un instantané (description, prix) : serviceId / planId /
// spaceId ne sont que des repères vers le catalogue (pas de clé étrangère —
// le catalogue peut évoluer sans réécrire un devis déjà envoyé).
model QuoteLine {
  id            String  @id @default(cuid())
  quoteId       String
  position      Int     @default(0)
  description   String  @db.Text
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal @default(0) @db.Decimal(12, 2)
  // Remise sur la ligne, en %.
  discountRate  Decimal @default(0) @db.Decimal(5, 2)
  serviceId     String?
  planId        String?
  spaceId       String?
  tierLabel     String?
  // Renouvellement : service du panier que cette ligne prolonge.
  renewsOrderId String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_lines")
}

// Modèles de devis (automatisation) : un devis pré-rempli en un clic.
// lines = [{ description, quantity, unitPrice, serviceSlug?, tierLabel? }]
model QuoteTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  validityDays Int      @default(15)
  notes        String?  @db.Text
  lines        Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("quote_templates")
}

// Brouillon → proforma envoyée (proformaNumber PF-…, statut SENT) → payée :
// le numéro de facture définitive (FA-…) n'est attribué qu'au paiement, pour
// une suite continue sans trous (processus v1.3, décision du 23/10/2026).
// Les factures émises avant ce changement gardent leur numéro FA-… d'émission.
model Invoice {
  id              String                @id @default(cuid())
  number          String?               @unique
  proformaNumber  String?               @unique
  leadId          String?
  quoteId         String?
  status          InvoiceStatus         @default(DRAFT)
  customerName    String
  customerCompany String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerNif     String?
  customerRc      String?
  customerAi      String?
  issueDate       DateTime?
  dueDate         DateTime?
  vatRate         Decimal               @default(19) @db.Decimal(5, 2)
  discountType    DiscountType?
  discountValue   Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal               @default(0) @db.Decimal(12, 2)
  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  vatAmount       Decimal               @default(0) @db.Decimal(12, 2)
  total           Decimal               @default(0) @db.Decimal(12, 2)
  currency        String                @default("DZD")
  notes           String?               @db.Text
  paidAt          DateTime?
  paymentMethod   InvoicePaymentMethod?
  paymentRef      String?
  refundedAt      DateTime?
  refundReason    String?
  lastReminderAt  DateTime?
  reminderCount   Int                   @default(0)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  serviceOrders ServiceOrder[]
  proofs        PaymentProof[]
  commissions   Commission[]

  @@index([status])
  @@index([leadId])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @default(cuid())
  invoiceId     String
  position      Int     @default(0)
  description   String  @db.Text
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal @default(0) @db.Decimal(12, 2)
  // Remise sur la ligne, en %.
  discountRate  Decimal @default(0) @db.Decimal(5, 2)
  serviceId     String?
  planId        String?
  spaceId       String?
  tierLabel     String?
  // Renouvellement : service du panier que cette ligne prolonge.
  renewsOrderId String?

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@index([invoiceId])
  @@map("invoice_lines")
}

// Service vendu = une ligne du panier de services du membre (processus v1.3).
// Créé au paiement (une commande par ligne de facture payée, avec sa
// checklist), livré par son pôle, validé par le membre, puis suivi jusqu'à son
// échéance et son renouvellement. Une ligne « formule d'abonnement » active en
// plus l'abonnement du membre rattaché (subscriptionId).
model ServiceOrder {
  id             String             @id @default(cuid())
  invoiceId      String
  invoiceLineId  String?
  leadId         String?
  userId         String?
  title          String
  pole           DeliveryPole       @default(SPACES)
  // Filiale IN Group concernée (pôle IN_GROUP) : IN COM, IN Academy…
  subsidiary     String?
  // Montant HT de la ligne vendue (instantané).
  amount         Decimal?           @db.Decimal(12, 2)
  // Bureau privatif attribué par l'Office Manager (location au mois).
  spaceId        String?
  status         ServiceOrderStatus @default(TO_START)
  assignedToId   String?
  dueAt          DateTime?
  startedAt      DateTime?
  // Livrable prêt : en attente de la validation du membre.
  readyAt        DateTime?
  adjustmentNote String?            @db.Text
  // Livré / Actif : validé par le membre (ou par le référent pour lui).
  completedAt    DateTime?
  validatedById  String?
  // Période couverte : début (activation) et échéance (null = sans échéance).
  startsAt       DateTime?
  expiresAt      DateTime?
  // Alertes d'échéance déjà envoyées (J-60, J-30, J-7) et passage « Expiré ».
  alert60At      DateTime?
  alert30At      DateTime?
  alert7At       DateTime?
  expiredAt      DateTime?
  // Renouvellement : le nouveau service pointe vers celui qu'il prolonge.
  renewedFromId  String?            @unique
  notes          String?            @db.Text
  subscriptionId String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  invoice      Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceLine  InvoiceLine?       @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  lead         Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user         User?              @relation("OrderMember", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo   User?              @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  validatedBy  User?              @relation("OrderValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  space        SpaceResource?     @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  renewedFrom  ServiceOrder?      @relation("OrderRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy    ServiceOrder?      @relation("OrderRenewal")
  tasks        ServiceOrderTask[]
  documents    MemberDocument[]
  commissions  Commission[]

  @@index([status])
  @@index([invoiceId])
  @@index([userId, status])
  @@index([pole, status])
  @@index([expiresAt])
  @@map("service_orders")
}

model ServiceOrderTask {
  id       String    @id @default(cuid())
  orderId  String
  position Int       @default(0)
  title    String
  isDone   Boolean   @default(false)
  doneAt   DateTime?

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("service_order_tasks")
}

// ============================================
// JUSTIFICATIFS DE PAIEMENT (demande client 20/09/2026)
// Envoyés par le membre depuis « Situation du compte » ; vérifiés par
// l'équipe, qui enregistre le paiement et valide le compte. Les fichiers
// sont stockés hors du dossier public (jamais servis en statique) et
// relus via une route authentifiée.
// ============================================

enum PaymentProofStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PaymentProof {
  id           String             @id @default(cuid())
  userId       String
  quoteId      String?
  invoiceId    String?
  // Chemin relatif au dossier privé des justificatifs (jamais une URL).
  filePath     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  amount       Decimal?           @db.Decimal(12, 2)
  reference    String?
  note         String?            @db.Text
  status       PaymentProofStatus @default(PENDING)
  reviewNote   String?            @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  user       User     @relation("ProofOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  quote      Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("payment_proofs")
}

// ============================================
// PROCESSUS COMMERCIAL v1.3 (23/10/2026)
// Documents remis au membre, commissions, paramètres réglables.
// ============================================

enum MemberDocumentKind {
  CONTRACT // contrat signé
  DOMICILIATION_CERTIFICATE // attestation de domiciliation
  OFFICIAL_DOCUMENT // documents officiels (RC, NIF, statuts…)
  RECEIPT // reçu de paiement
  OTHER
}

// Documents remis au membre (contrat, attestation, documents officiels…),
// déposés par l'équipe et consultables dans l'historique de l'espace membre.
// Stockés hors du dossier public, comme les justificatifs de paiement.
model MemberDocument {
  id           String             @id @default(cuid())
  userId       String
  orderId      String?
  kind         MemberDocumentKind @default(OTHER)
  title        String
  filePath     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime           @default(now())

  user       User          @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  order      ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  uploadedBy User?         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("member_documents")
}

enum CommissionBeneficiary {
  CLOSER // commercial de la Sales Team qui a transmis le dossier (circuit 1)
  OFFICE_MANAGER // Office Manager (circuits 1 et 2)
}

enum CommissionMode {
  RATE // pourcentage du montant HT
  FIXED // montant fixe par ligne vendue
}

// Calculée au paiement → éligible quand le service est livré → contrôlée par
// le responsable commercial (circuit 1) → validée par la Direction → versée.
// Reprise (CANCELLED) si la facture est remboursée.
enum CommissionStatus {
  PENDING
  ELIGIBLE
  CHECKED
  VALIDATED
  PAID
  CANCELLED
}

// Barème saisi par IN NETWORK. La règle la plus précise l'emporte : service
// (ou formule) > catégorie > règle générale. leadKind / circuit null = toutes
// les affaires. Aucune commission n'est calculée sans règle applicable.
model CommissionRule {
  id          String                @id @default(cuid())
  beneficiary CommissionBeneficiary
  serviceId   String?
  planId      String?
  category    ServiceCategory?
  leadKind    LeadKind?
  circuit     LeadCircuit?
  mode        CommissionMode
  value       Decimal               @db.Decimal(12, 2)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  service ServiceCatalogItem? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  plan    MembershipPlan?     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([beneficiary, isActive])
  @@map("commission_rules")
}

// Une ligne par bénéficiaire et par ligne de facture payée.
model Commission {
  id            String                @id @default(cuid())
  leadId        String?
  invoiceId     String
  invoiceLineId String?
  orderId       String?
  beneficiaryId String
  role          CommissionBeneficiary
  ruleId        String?
  description   String
  baseAmount    Decimal               @db.Decimal(12, 2)
  amount        Decimal               @db.Decimal(12, 2)
  status        CommissionStatus      @default(PENDING)
  checkedById   String?
  checkedAt     DateTime?
  validatedById String?
  validatedAt   DateTime?
  paidAt        DateTime?
  cancelledAt   DateTime?
  note          String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order       ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  beneficiary User          @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([invoiceLineId, role])
  @@index([beneficiaryId, status])
  @@index([status])
  @@map("commissions")
}

// Paramètres du processus réglables par l'administrateur sans développement
// (délais de relance, seuil de validation des devis, délai de grâce…).
// Valeurs par défaut et validation : cf. src/modules/settings/settings.service.ts.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}
