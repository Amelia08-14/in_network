# Copie ce fichier en .env et adapte les valeurs

# --- Base de données ---
# Local (XAMPP MySQL, port par défaut 3306, utilisateur root sans mot de passe) :
DATABASE_URL="mysql://root:@localhost:3306/in_network"
# Sur le VPS (exemple) :
# DATABASE_URL="mysql://in_network_user:CHANGE_ME@localhost:3306/in_network"

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# URL canonique unique du frontend, utilisée dans les liens envoyés par email
# (vérification, reset mdp). En prod : une seule des deux variantes du domaine
# (ex. https://www.in-network.dz), jamais une liste.
APP_URL=http://localhost:3000

# --- Auth JWT ---
JWT_ACCESS_SECRET=change_me_dev_access_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Email transactionnel — SMTP (compte hébergeur, prioritaire si renseigné) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IN NETWORK <no-reply@innetwork.dz>"

# --- Email transactionnel — Resend (repli si pas de SMTP configuré) ---
RESEND_API_KEY=

# --- SMS (fournisseur non déterminé — cf. CDC §9, dépendance ouverte) ---
SMS_PROVIDER=

# --- Paiement (Chargily Pay proposé — cf. CDC §1.4, à confirmer) ---
CHARGILY_API_KEY=
CHARGILY_WEBHOOK_SECRET=

# --- Stockage fichiers (S3-compatible / Cloudflare R2) ---
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=auto

# --- Moteur de matching ---
MATCHING_SCORE_THRESHOLD=40
